# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://xtreampulsar:password@postgres:5432/xtreampulsar
POSTGRES_DB=xtreampulsar
POSTGRES_USER=xtreampulsar
POSTGRES_PASSWORD=change-this-secure-password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=change-this-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── License ─────────────────────────────────────────────────────────────────
# URL of the license server (apps/license service)
LICENSE_SERVER_URL=https://license.xtreampulsar.io
# Your panel license key (obtained from XtreamPulsar)
LICENSE_KEY=your-license-key-here
# Admin API key for the license server (keep this secret)
ADMIN_API_KEY=change-this-admin-key

# ─── Panel / Server ──────────────────────────────────────────────────────────
# Public URL of your panel (used for license IP detection)
SERVER_URL=https://your-panel-domain.com
# Xtream-compatible API port
SERVER_PORT=25461
# Path to ffmpeg binary inside the API container
FFMPEG_PATH=/usr/bin/ffmpeg
# Directory where HLS segments are written
HLS_OUTPUT_PATH=/tmp/xtreampulsar/hls

# ─── Stripe (future phase) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Load Balancer (docker-compose.lb.yml only) ──────────────────────────────
MAIN_SERVER_HOST=your-main-server-ip-or-hostname
MAIN_SERVER_USER=root
HLS_REMOTE_PATH=/tmp/xtreampulsar/hls
SYNC_INTERVAL=5
SSH_KEY_PATH=~/.ssh/id_rsa

# Read-only demo lock — when "true", blocks all data-changing requests
# (POST/PUT/PATCH/DELETE) except login. Use ONLY on a public demo server.
DEMO_MODE=false
