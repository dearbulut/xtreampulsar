{
  "name": "xtreampulsar",
  "version": "0.0.1",
  "private": true,
  "description": "XtreamPulsar — IPTV middleware monorepo",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @xtreampulsar/api dev",
    "dev:web": "pnpm --filter @xtreampulsar/web dev",
    "dev:license": "pnpm --filter @xtreampulsar/license dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @xtreampulsar/database generate",
    "db:migrate": "pnpm --filter @xtreampulsar/database migrate",
    "db:studio": "pnpm --filter @xtreampulsar/database studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "5.4.5"
  }
}
