generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

enum LicenseTier {
  STARTER
  PRO
  BUSINESS
  WHITE_LABEL
}

enum ServerRole {
  MAIN
  LOAD_BALANCER
}

enum StreamStatus {
  ONLINE
  OFFLINE
  BUFFERING
  ERROR
}

enum WorkerStatus {
  IDLE
  RUNNING
  CRASHED
  STOPPED
}

enum CategoryType {
  LIVE
  VOD
  SERIES
}

enum UserStatus {
  ACTIVE
  DISABLED
  EXPIRED
  BANNED
}

enum UserRole {
  ADMIN
  RESELLER
  USER
}

enum ResellerTier {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

enum CreditLogType {
  ADD
  DEDUCT
}

enum MigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationSource {
  XTREAMUI
  XUIONE
  M3U
  XTREAM_API
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LICENSE_VALIDATE
  STREAM_START
  STREAM_STOP
}

// ─── License ─────────────────────────────────────────────────────────────────

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  serverIp       String?
  tier           LicenseTier   @default(STARTER)
  status         LicenseStatus @default(PENDING)
  expiresAt      DateTime
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  verificationLogs LicenseVerificationLog[]

  @@map("licenses")
}

model LicenseVerificationLog {
  id         String   @id @default(cuid())
  licenseKey String
  serverIp   String
  version    String
  isValid    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  license License @relation(fields: [licenseKey], references: [key], onDelete: Cascade)

  @@index([licenseKey, createdAt])
  @@map("license_verification_logs")
}

// ─── Server ──────────────────────────────────────────────────────────────────

model Server {
  id            String     @id @default(cuid())
  name          String
  ip            String     @unique
  port          Int        @default(8080)
  role          ServerRole @default(MAIN)
  maxClients    Int        @default(1000)
  isOnline      Boolean    @default(false)
  location      String?
  lastCheckedAt DateTime?
  responseTime  Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  streams     Stream[]
  connections Connection[]
  guard       ServerGuard?
  blockedIps  BlockedIp[]

  @@map("servers")
}

model ServerGuard {
  id                   String   @id @default(cuid())
  enabled              Boolean  @default(false)
  sensitivePorts       Int[]    @default([22, 7999])
  whitelistIps         String[] @default([])
  openPorts            Int[]    @default([80, 25461, 443])
  maxConnsPerIp        Int      @default(200)
  maxHitsNormalUser    Int      @default(50)
  maxHitsRestreamer    Int      @default(500)
  whitelistUsernames   String[] @default([])
  blockDurationMinutes Int      @default(10)
  denyInvalidStreamIds Boolean  @default(true)
  blockVpnProxy        Boolean  @default(false)
  geoBlockedCountries  String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  serverId String @unique
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_guards")
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String
  reason    String
  bannedBy  String?
  blockedAt DateTime @default(now())
  expiresAt DateTime

  serverId String?
  server   Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, ip])
  @@index([ip])
  @@map("blocked_ips")
}

// ─── Bouquet & Category ───────────────────────────────────────────────────────

model Bouquet {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories    Category[]
  bouquetStreams BouquetStream[]
  userBouquets  UserBouquet[]
  packages      Package[]

  @@map("bouquets")
}

model Category {
  id         String       @id @default(cuid())
  externalId Int          @unique @default(autoincrement())
  name       String
  type       CategoryType
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  bouquetId String
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id])

  streams Stream[]

  @@map("categories")
}

// ─── Stream ──────────────────────────────────────────────────────────────────

model Stream {
  id              String       @id @default(cuid())
  externalId      Int          @unique @default(autoincrement())
  name            String
  primaryUrl      String
  backupUrl       String?
  backupUrls      String[] @default([])
  ffmpegPid       Int?
  streamMode      String       @default("PROXY") // PROXY | TRANSCODE
  workerStatus    WorkerStatus @default(IDLE)
  restartCount    Int          @default(0)
  status          StreamStatus @default(OFFLINE)
  tvgId           String?
  tvgLogo         String?
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  lastHealthCheck DateTime?
  healthStatus    String?
  uptimePercent   Float?       @default(100)
  lastError       String?
  qualityScore    String?
  resolution      String?
  videoBitrate    Int?
  videoCodec      String?
  fps             Float?
  lastAnalyzedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // TMDB metadata
  tmdbId      Int?
  overview    String?
  posterUrl   String?
  backdropUrl String?
  releaseYear Int?
  tmdbRating  Float?
  tmdbGenres  String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  serverId String?
  server   Server?  @relation(fields: [serverId], references: [id])

  epgMappings    EPGMapping[]
  connections    Connection[]
  bouquetStreams BouquetStream[]
  healthLogs     StreamHealthLog[]
  episodes       Episode[]         @relation("SeriesEpisodes")

  @@map("streams")
}

model Episode {
  id                 String   @id @default(cuid())
  externalId         Int      @unique @default(autoincrement())
  seriesId           String
  series             Stream   @relation("SeriesEpisodes", fields: [seriesId], references: [id], onDelete: Cascade)
  season             Int
  episode            Int
  title              String?
  primaryUrl         String
  containerExtension String   @default("mkv")
  plot               String?
  durationSecs       Int?
  tmdbRating         Float?
  releaseDate        String?
  cover              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([seriesId, season, episode])
  @@index([seriesId])
  @@map("episodes")
}

model BouquetStream {
  sortOrder Int @default(0)

  bouquetId String
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id], onDelete: Cascade)

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([bouquetId, streamId])
  @@map("bouquet_streams")
}

// ─── EPG ─────────────────────────────────────────────────────────────────────

model EPGSource {
  id         String    @id @default(cuid())
  name       String
  xmltvUrl   String
  lastParsed DateTime?
  daysToKeep Int       @default(7)
  isActive   Boolean   @default(true)
  status     String    @default("IDLE") // IDLE | RUNNING | SUCCESS | FAILED
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  mappings EPGMapping[]
  channels EPGChannel[]

  @@map("epg_sources")
}

model EPGMapping {
  id           String   @id @default(cuid())
  epgChannelId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  epgSourceId String
  epgSource   EPGSource @relation(fields: [epgSourceId], references: [id], onDelete: Cascade)

  @@unique([streamId, epgSourceId])
  @@map("epg_mappings")
}

model EPGChannel {
  id          String   @id @default(cuid())
  channelId   String
  displayName String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  epgSourceId String
  epgSource   EPGSource @relation(fields: [epgSourceId], references: [id], onDelete: Cascade)

  programmes EPGProgramme[]

  @@unique([epgSourceId, channelId])
  @@map("epg_channels")
}

model EPGProgramme {
  id          String   @id @default(cuid())
  start       DateTime
  stop        DateTime
  title       String
  description String?
  createdAt   DateTime @default(now())

  epgChannelId String
  epgChannel   EPGChannel @relation(fields: [epgChannelId], references: [id], onDelete: Cascade)

  // Mantıksal doğal anahtar: bir kanalda bir başlangıç anında tek program olabilir.
  // Reparse'ın duplicate üretmesini engeller (skipDuplicates artık gerçek çalışır).
  @@unique([epgChannelId, start])
  @@map("epg_programmes")
}

// ─── Reseller & User ─────────────────────────────────────────────────────────

model Reseller {
  id        String       @id @default(cuid())
  username  String       @unique
  email     String?      @unique
  password  String
  credits   Int          @default(0)
  maxUsers  Int          @default(0)
  tier      ResellerTier @default(BASIC)
  isActive   Boolean      @default(true)
  notes      String?
  brandName  String?
  logoUrl    String?
  deletedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parentId String?
  parent   Reseller?  @relation("ResellerHierarchy", fields: [parentId], references: [id])
  children Reseller[] @relation("ResellerHierarchy")

  users         User[]
  creditLogs    ResellerCreditLog[]
  notifications ResellerNotification[]
  refreshTokens ResellerRefreshToken[]

  @@map("resellers")
}

model ResellerRefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId])
  @@index([token])
  @@map("reseller_refresh_tokens")
}

model ResellerNotification {
  id         String   @id @default(cuid())
  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resellerId, isRead])
  @@map("reseller_notifications")
}

model ResellerCreditLog {
  id           String        @id @default(cuid())
  amount       Int
  type         CreditLogType
  reason       String?
  balanceAfter Int
  adminId      String?
  createdAt    DateTime      @default(now())

  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id])

  @@index([resellerId])
  @@map("reseller_credit_logs")
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  password         String
  role             UserRole   @default(USER)
  maxConnections   Int        @default(1)
  status           UserStatus @default(ACTIVE)
  expiresAt        DateTime
  notes            String?
  isTrial          Boolean    @default(false)
  trialEndsAt      DateTime?
  deletedAt        DateTime?
  twoFactorSecret     String?
  twoFactorTempSecret String?
  twoFactorEnabled Boolean    @default(false)
  require2FA       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  connections    Connection[]
  refreshTokens  RefreshToken[]
  userBouquets   UserBouquet[]
  magDevices     MagDevice[]
  apiKeys        ApiKey[]
  activityLogs   UserActivityLog[]
  playlists      UserPlaylist[]

  @@index([packageId])
  @@map("users")
}

// ─── UserPlaylist ─────────────────────────────────────────────────────────────

model UserPlaylist {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  token        String    @unique @default(cuid())
  type         String    @default("m3u_plus")
  filters      Json?
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  lastAccessed DateTime?
  accessCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@map("user_playlists")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Package ─────────────────────────────────────────────────────────────────

model Package {
  id             String   @id @default(cuid())
  name           String
  durationDays   Int
  maxConnections Int      @default(1)
  creditCost     Int
  price          Float    @default(0)
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
  // Paket satın alan/atanan kullanıcı bu bouquet'leri miras alır (implicit m2m).
  bouquets Bouquet[]

  @@map("packages")
}

// ─── Connection ──────────────────────────────────────────────────────────────

model Connection {
  id        String    @id @default(cuid())
  ip        String
  userAgent String?
  token     String?
  startedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?
  bytesIn   BigInt    @default(0)
  bytesOut  BigInt    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  serverId String?
  server   Server? @relation(fields: [serverId], references: [id])

  @@index([userId, endedAt])
  @@index([streamId, endedAt])
  @@index([startedAt])
  @@index([updatedAt])
  @@map("connections")
}

// ─── Migration ───────────────────────────────────────────────────────────────

model MigrationJob {
  id               String          @id @default(cuid())
  source           MigrationSource
  status           MigrationStatus @default(PENDING)
  totalRecords     Int             @default(0)
  processedRecords Int             @default(0)
  failedRecords    Int             @default(0)
  errors           Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("migration_jobs")
}

// ─── Settings (singleton) ────────────────────────────────────────────────────

model Settings {
  id                      String   @id @default("singleton")
  vodDownloadSpeed        Int      @default(200)
  vodDownloadLimit        Int      @default(20)
  bufferSize              Int      @default(8192)
  blockVpnProxy           Boolean  @default(false)
  priorityBackupStream    Boolean  @default(false)
  streamDownVideo         String?
  bannedVideo             String?
  expiredVideo            String?
  countryLockVideo        String?
  maxConxExceedVideo      String?
  enableConxExceedLog     Boolean  @default(false)
  instantCloseConn        Boolean  @default(false)
  adminStreamingIps       String[] @default([])
  panelName               String   @default("XtreamPulsar")
  serverUrl               String   @default("")
  serverUrls              String[] @default([])
  primaryUrlIndex         Int      @default(0)
  urlHealthCheck          Boolean  @default(true)
  serverPort              Int      @default(25461)
  timezone                String   @default("UTC")
  trialUserLimit          Int      @default(500)
  trialDays               Int      @default(7)
  trialMaxConnections     Int      @default(1)
  adminEmail              String   @default("")
  resellerNotifyExpiry    Boolean  @default(true)
  streamDownAlert         Boolean  @default(true)
  enableLocalBackups      Boolean  @default(false)
  localBackupDir          String   @default("/opt/xtreampulsar/backups")
  autoBackupIntervalHours Int      @default(6)
  backupsToKeep           Int      @default(5)
  enableRemoteBackup      Boolean  @default(false)
  dropboxApiKey           String   @default("")
  discordWebhookUrl       String?
  telegramBotToken        String?
  telegramChatId          String?
  discordAlerts           Boolean  @default(false)
  telegramAlerts          Boolean  @default(false)
  tmdbApiKey              String?
  autoEnrichMetadata      Boolean  @default(false)
  // Reseller
  registrationOpen        Boolean  @default(false)
  tierPricing             Json     @default("{}")
  creditPricing           Json?
  // Panel geo-block
  geoBlockEnabled         Boolean  @default(false)
  allowedCountries        String[] @default([])
  // Security / Server Guard
  enableGuard             Boolean  @default(false)
  maxConnsPerIp           Int      @default(10)
  maxHitsNormal           Int      @default(100)
  maxHitsRestreamer       Int      @default(50)
  blockDuration           Int      @default(60)
  denyInvalidStreamIds    Boolean  @default(true)
  sensitivePorts          String[] @default([])
  whitelistIPs            String[] @default([])
  openPorts               String[] @default([])
  updatedAt               DateTime @updatedAt

  @@map("settings")
}

// ─── UserBouquet ─────────────────────────────────────────────────────────────

model UserBouquet {
  userId    String
  bouquetId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id], onDelete: Cascade)

  @@id([userId, bouquetId])
  @@map("user_bouquets")
}

// ─── BackupLog ───────────────────────────────────────────────────────────────

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  type      String   @default("LOCAL")
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())

  @@map("backup_logs")
}

// ─── NotificationLog ─────────────────────────────────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())
  type      String
  recipient String
  subject   String
  status    String   @default("SENT")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notification_logs")
}

// ─── StreamHealthLog ─────────────────────────────────────────────────────────

model StreamHealthLog {
  id           String   @id @default(cuid())
  streamId     String
  stream       Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  status       String
  responseTime Int?
  errorMessage String?
  checkedAt    DateTime @default(now())

  @@index([streamId, checkedAt])
  @@map("stream_health_logs")
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  actorId    String?
  actorType  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId, actorType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── MagDevice (Stalker/MAG) ─────────────────────────────────────────────────

model MagDevice {
  id           String    @id @default(cuid())
  mac          String    @unique
  serialNumber String?
  token        String?
  lastSeen     DateTime  @default(now())
  createdAt    DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([mac])
  @@map("mag_devices")
}

// ─── ApiKey ──────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions String[]  @default(["read"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

// ─── WhiteLabel ───────────────────────────────────────────────────────────────

model WhiteLabel {
  id             String   @id @default(cuid())
  panelName      String
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#8b5cf6")
  customDomain   String?  @unique
  customCss      String?
  footerText     String?
  supportEmail   String?
  supportUrl     String?
  isActive       Boolean  @default(true)
  licenseKey     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("white_labels")
}

// ─── BandwidthLog ─────────────────────────────────────────────────────────────

model BandwidthLog {
  id       String   @id @default(cuid())
  streamId String?
  serverId String?
  bytesIn  BigInt   @default(0)
  bytesOut BigInt   @default(0)
  hour     DateTime

  @@unique([streamId, serverId, hour])
  @@index([hour])
  @@map("bandwidth_logs")
}

// ─── UserActivityLog ─────────────────────────────────────────────────────────

model UserActivityLog {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           String
  streamId         String?
  ip               String?
  userAgent        String?
  duration         Int?
  bytesTransferred BigInt?
  country          String?
  deviceType       String?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_activity_logs")
}

model Webhook {
  id            String    @id @default(cuid())
  name          String
  url           String
  secret        String?
  events        String[]
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  lastStatus    Int?
  createdAt     DateTime  @default(now())

  @@map("webhooks")
}

// ─── Control Panel ────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String?
  country   String?
  notes     String?
  status    String    @default("ACTIVE")
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  licenses CustomerLicense[]
  tickets  Ticket[]
  invoices Invoice[]

  @@map("customers")
}

model CustomerLicense {
  id             String    @id @default(cuid())
  key            String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  plan           String    @default("STARTER")
  status         String    @default("TRIAL")
  serverIp       String?
  serverDomain   String?
  version        String?
  maxUsers       Int       @default(500)
  maxServers     Int       @default(2)
  trialEndsAt    DateTime?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  lastSeenAt     DateTime?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs    CustomerLicenseLog[]
  tickets Ticket[]

  @@map("customer_licenses")
}

model CustomerLicenseLog {
  id        String          @id @default(cuid())
  licenseId String
  license   CustomerLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  serverIp  String
  success   Boolean
  message   String?
  createdAt DateTime        @default(now())

  @@map("customer_license_logs")
}

model Ticket {
  id           String           @id @default(cuid())
  ticketNo     String           @unique
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  licenseId    String?
  license      CustomerLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  subject      String
  status       String           @default("OPEN")
  priority     String           @default("MEDIUM")
  category     String           @default("GENERAL")
  panelUrl     String?
  panelVersion String?
  serverIp     String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content    String
  isStaff    Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())

  @@map("ticket_messages")
}

model Invoice {
  id         String    @id @default(cuid())
  invoiceNo  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  amount     Float
  currency   String    @default("EUR")
  status     String    @default("PENDING")
  plan       String?
  period     String?
  stripeId   String?
  paidAt     DateTime?
  dueAt      DateTime?
  createdAt  DateTime  @default(now())

  @@map("invoices")
}

model ControlAdmin {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("control_admins")
}
