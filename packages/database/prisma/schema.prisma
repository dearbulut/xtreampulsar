generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

enum LicenseTier {
  STARTER
  PRO
  BUSINESS
  WHITE_LABEL
}

enum ServerRole {
  MAIN
  LOAD_BALANCER
}

enum StreamStatus {
  ONLINE
  OFFLINE
  BUFFERING
  ERROR
}

enum WorkerStatus {
  IDLE
  RUNNING
  CRASHED
  STOPPED
}

enum CategoryType {
  LIVE
  VOD
  SERIES
}

enum UserStatus {
  ACTIVE
  DISABLED
  EXPIRED
  BANNED
}

enum UserRole {
  ADMIN
  RESELLER
  USER
}

enum ResellerTier {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

enum CreditLogType {
  ADD
  DEDUCT
}

enum MigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MigrationSource {
  XTREAMUI
  XUIONE
  M3U
  XTREAM_API
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LICENSE_VALIDATE
  STREAM_START
  STREAM_STOP
}

// ─── License ─────────────────────────────────────────────────────────────────

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  serverIp       String?
  tier           LicenseTier   @default(STARTER)
  status         LicenseStatus @default(PENDING)
  expiresAt      DateTime
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  verificationLogs LicenseVerificationLog[]

  @@map("licenses")
}

model LicenseVerificationLog {
  id         String   @id @default(cuid())
  licenseKey String
  serverIp   String
  version    String
  isValid    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  license License @relation(fields: [licenseKey], references: [key], onDelete: Cascade)

  @@index([licenseKey, createdAt])
  @@map("license_verification_logs")
}

// ─── Server ──────────────────────────────────────────────────────────────────

model Server {
  id            String     @id @default(cuid())
  name          String
  ip            String     @unique
  port          Int        @default(8080)
  role          ServerRole @default(MAIN)
  maxClients    Int        @default(1000)
  isOnline      Boolean    @default(false)
  location      String?
  apiSecret     String?    // edge node NODE_SECRET ile eslesir — metrik cekmek icin
  lastCheckedAt DateTime?
  responseTime  Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  streams     Stream[]
  connections Connection[]
  guard       ServerGuard?
  blockedIps  BlockedIp[]

  @@map("servers")
}

model ServerGuard {
  id                   String   @id @default(cuid())
  enabled              Boolean  @default(false)
  sensitivePorts       Int[]    @default([22, 7999])
  whitelistIps         String[] @default([])
  openPorts            Int[]    @default([80, 25461, 443])
  maxConnsPerIp        Int      @default(200)
  maxHitsNormalUser    Int      @default(50)
  maxHitsRestreamer    Int      @default(500)
  whitelistUsernames   String[] @default([])
  blockDurationMinutes Int      @default(10)
  denyInvalidStreamIds Boolean  @default(true)
  blockVpnProxy        Boolean  @default(false)
  geoBlockedCountries  String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  serverId String @unique
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_guards")
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String
  reason    String
  bannedBy  String?
  blockedAt DateTime @default(now())
  expiresAt DateTime

  serverId String?
  server   Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, ip])
  @@index([ip])
  @@map("blocked_ips")
}

// ─── Bouquet & Category ───────────────────────────────────────────────────────

model Bouquet {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories    Category[]
  bouquetStreams BouquetStream[]
  userBouquets  UserBouquet[]
  packages      Package[]

  @@map("bouquets")
}

model Category {
  id         String       @id @default(cuid())
  externalId Int          @unique @default(autoincrement())
  name       String
  type       CategoryType
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  bouquetId String
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id])

  streams Stream[]

  @@map("categories")
}

// ─── Stream ──────────────────────────────────────────────────────────────────

model Stream {
  id              String       @id @default(cuid())
  externalId      Int          @unique @default(autoincrement())
  name            String
  primaryUrl      String
  backupUrl       String?
  backupUrls      String[] @default([])
  ffmpegPid       Int?
  streamMode      String       @default("PROXY") // PROXY | TRANSCODE | LOOP
  loopSources     String[]     @default([]) // LOOP modu: 24/7 dongulenen kaynak listesi (URL)
  loopShuffle     Boolean      @default(false) // LOOP: her dongude sirayi karistir
  catchupEnabled  Boolean      @default(false) // catch-up/DVR: yayini arsivle (geriye sarma)
  catchupDays     Int          @default(7)     // arsivi kac gun tut
  workerStatus    WorkerStatus @default(IDLE)
  restartCount    Int          @default(0)
  // ─── Gelismis akis ayarlari (Xtream UI paritesi — roadmap B) ───────────────
  directSource      Boolean  @default(false) // istemciyi upstream URL'ine 302 yonlendir (proxy yok)
  streamUserAgent   String?                  // upstream cekiminde kullanilacak User-Agent
  httpProxy         String?                  // upstream icin http proxy (ip:port)
  httpCookie        String?                  // upstream istegine eklenecek Cookie
  httpHeaders       String?                  // ek header'lar (satir basi "K: V")
  customFfmpeg      String?                  // TRANSCODE/LOOP icin ek ffmpeg argumanlari
  customMap         String?                  // ozel -map argumanlari
  probeSize         Int?                     // ffmpeg probesize/analyzeduration
  delayMinutes      Int      @default(0)     // yayin gecikmesi (dk)
  transcodeProfile  String?                  // transkodlama profili referansi (ileride profil tablosu)
  generatePts       Boolean  @default(true)  // ffmpeg +genpts
  allowRecording    Boolean  @default(true)  // catch-up/kayit izni
  allowRtmpOutput   Boolean  @default(false) // RTMP cikisina izin
  restartDays       String[] @default([])    // otomatik yeniden baslatma gunleri (Mon..Sun)
  restartTime       String?                  // otomatik yeniden baslatma saati (HH:MM)
  epgSourceId       String?                  // per-stream EPG kaynagi
  epgLang           String?                  // per-stream EPG dili
  status          StreamStatus @default(OFFLINE)
  tvgId           String?
  tvgLogo         String?
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  lastHealthCheck DateTime?
  healthStatus    String?
  uptimePercent   Float?       @default(100)
  lastError       String?
  qualityScore    String?
  resolution      String?
  videoBitrate    Int?
  videoCodec      String?
  fps             Float?
  lastAnalyzedAt  DateTime?
  durationSecs    Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // TMDB metadata
  tmdbId      Int?
  overview    String?
  posterUrl   String?
  backdropUrl String?
  releaseYear Int?
  tmdbRating  Float?
  tmdbGenres  String[]
  cast            String[] @default([]) // oyuncular
  director        String?                 // yonetmen
  subtitlePath    String?                 // harici altyazi dosya yolu
  targetContainer String?                 // VOD hedef konteyner (mp4/mkv)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  serverId String?
  server   Server?  @relation(fields: [serverId], references: [id])

  // Stream Providers mirror linkage (Increment 2)
  providerId  String?
  provider    StreamProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerRef String?         // upstream dedup key: "<TYPE>:<stream_id>"

  epgMappings    EPGMapping[]
  connections    Connection[]
  bouquetStreams BouquetStream[]
  healthLogs     StreamHealthLog[]
  episodes       Episode[]         @relation("SeriesEpisodes")
  clientRequests ClientRequest[]

  @@index([providerId])
  @@map("streams")
}

model Episode {
  id                 String   @id @default(cuid())
  externalId         Int      @unique @default(autoincrement())
  seriesId           String
  series             Stream   @relation("SeriesEpisodes", fields: [seriesId], references: [id], onDelete: Cascade)
  season             Int
  episode            Int
  title              String?
  primaryUrl         String
  containerExtension String   @default("mkv")
  plot               String?
  durationSecs       Int?
  tmdbRating         Float?
  releaseDate        String?
  cover              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([seriesId, season, episode])
  @@index([seriesId])
  @@map("episodes")
}

model BouquetStream {
  sortOrder Int @default(0)

  bouquetId String
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id], onDelete: Cascade)

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([bouquetId, streamId])
  @@map("bouquet_streams")
}

// ─── EPG ─────────────────────────────────────────────────────────────────────

model EPGSource {
  id         String    @id @default(cuid())
  name       String
  xmltvUrl   String
  lastParsed DateTime?
  daysToKeep Int       @default(7)
  isActive   Boolean   @default(true)
  status     String    @default("IDLE") // IDLE | RUNNING | SUCCESS | FAILED
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  mappings EPGMapping[]
  channels EPGChannel[]

  @@map("epg_sources")
}

model EPGMapping {
  id           String   @id @default(cuid())
  epgChannelId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  epgSourceId String
  epgSource   EPGSource @relation(fields: [epgSourceId], references: [id], onDelete: Cascade)

  @@unique([streamId, epgSourceId])
  @@map("epg_mappings")
}

model EPGChannel {
  id          String   @id @default(cuid())
  channelId   String
  displayName String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  epgSourceId String
  epgSource   EPGSource @relation(fields: [epgSourceId], references: [id], onDelete: Cascade)

  programmes EPGProgramme[]

  @@unique([epgSourceId, channelId])
  @@map("epg_channels")
}

model EPGProgramme {
  id          String   @id @default(cuid())
  start       DateTime
  stop        DateTime
  title       String
  description String?
  createdAt   DateTime @default(now())

  epgChannelId String
  epgChannel   EPGChannel @relation(fields: [epgChannelId], references: [id], onDelete: Cascade)

  // Mantıksal doğal anahtar: bir kanalda bir başlangıç anında tek program olabilir.
  // Reparse'ın duplicate üretmesini engeller (skipDuplicates artık gerçek çalışır).
  @@unique([epgChannelId, start])
  @@map("epg_programmes")
}

// ─── Reseller & User ─────────────────────────────────────────────────────────

model Reseller {
  id        String       @id @default(cuid())
  username  String       @unique
  email     String?      @unique
  password  String
  credits   Int          @default(0)
  maxUsers  Int          @default(0)
  billingModel    String       @default("CREDITS") // CREDITS | USERS
  slotsValidUntil DateTime?
  tier      ResellerTier @default(BASIC)
  isActive   Boolean      @default(true)
  notes      String?
  brandName  String?
  logoUrl    String?
  badgeText  String?
  badgeColor String?
  deletedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  parentId String?
  parent   Reseller?  @relation("ResellerHierarchy", fields: [parentId], references: [id])
  children Reseller[] @relation("ResellerHierarchy")

  // Affiliate: bu bayiyi kim getirdi (referans)
  referralCode String?    @unique
  referredById String?
  referredBy   Reseller?  @relation("ResellerReferral", fields: [referredById], references: [id])
  referrals    Reseller[] @relation("ResellerReferral")

  users         User[]
  creditLogs    ResellerCreditLog[]
  notifications ResellerNotification[]
  refreshTokens ResellerRefreshToken[]
  apiKeys       ResellerApiKey[]

  @@map("resellers")
}

model ResellerRefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId])
  @@index([token])
  @@map("reseller_refresh_tokens")
}

model ResellerNotification {
  id         String   @id @default(cuid())
  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resellerId, isRead])
  @@map("reseller_notifications")
}

model ResellerCreditLog {
  id           String        @id @default(cuid())
  amount       Int
  type         CreditLogType
  reason       String?
  balanceAfter Int
  adminId      String?
  createdAt    DateTime      @default(now())

  resellerId String
  reseller   Reseller @relation(fields: [resellerId], references: [id])

  @@index([resellerId])
  @@map("reseller_credit_logs")
}

model User {
  id               String     @id @default(cuid())
  username         String     @unique
  password         String
  plainPassword    String?
  role             UserRole   @default(USER)
  maxConnections   Int        @default(1)
  status           UserStatus @default(ACTIVE)
  expiresAt        DateTime
  notes            String?
  isTrial          Boolean    @default(false)
  // Hat erişim kontrolü (anti-abuse)
  allowedIps       String[]   @default([])
  allowedCountries String[]   @default([])
  blockVpn         Boolean    @default(false)
  blockDatacenter  Boolean    @default(false)
  hiddenCategoryIds String[]  @default([])
  lockDevice       Boolean    @default(false)
  lockedDeviceId   String?
  trialEndsAt      DateTime?
  deletedAt        DateTime?
  twoFactorSecret     String?
  twoFactorTempSecret String?
  twoFactorEnabled Boolean    @default(false)
  require2FA       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  resellerId String?
  reseller   Reseller? @relation(fields: [resellerId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Roadmap D — RBAC: yonetici/personel izin grubu (opsiyonel; yoksa role bazli davranis korunur)
  adminGroupId String?
  adminGroup   AdminGroup? @relation(fields: [adminGroupId], references: [id], onDelete: SetNull)

  connections    Connection[]
  refreshTokens  RefreshToken[]
  userBouquets   UserBouquet[]
  magDevices     MagDevice[]
  apiKeys        ApiKey[]
  activityLogs   UserActivityLog[]
  playlists      UserPlaylist[]
  clientRequests ClientRequest[]

  @@index([packageId])
  @@index([adminGroupId])
  @@map("users")
}

// ─── UserPlaylist ─────────────────────────────────────────────────────────────

model UserPlaylist {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  token        String    @unique @default(cuid())
  type         String    @default("m3u_plus")
  filters      Json?
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  lastAccessed DateTime?
  accessCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@map("user_playlists")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Package ─────────────────────────────────────────────────────────────────

model Package {
  id             String   @id @default(cuid())
  name           String
  durationDays   Int
  maxConnections Int      @default(1)
  creditCost     Int
  price          Float    @default(0)
  description    String?
  isActive       Boolean  @default(true)
  isPublic       Boolean  @default(false) // self-servis magazada satisa acik
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
  // Paket satın alan/atanan kullanıcı bu bouquet'leri miras alır (implicit m2m).
  bouquets Bouquet[]

  @@map("packages")
}

// ─── StreamSubtitle (icerik altyazi onbellegi — OpenSubtitles) ────────────────

model StreamSubtitle {
  id        String   @id @default(cuid())
  streamId  String
  language  String
  label     String?
  content   String
  createdAt DateTime @default(now())

  @@unique([streamId, language])
  @@index([streamId])
  @@map("stream_subtitles")
}

// ─── ResellerCommission (affiliate komisyonu — kredi bazli) ──────────────────

model ResellerCommission {
  id               String    @id @default(cuid())
  resellerId       String    // komisyonu kazanan (referans veren) bayi
  sourceResellerId String?   // komisyonu ureten (referans edilen) bayi
  amount           Int       // kazanilan kredi
  note             String?
  status           String    @default("PENDING") // PENDING | PAID
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([resellerId, status])
  @@map("reseller_commissions")
}

// ─── StoreOrder (self-servis magaza siparisi) ────────────────────────────────

// ─── PanelInvoice (operator → musteri/bayi faturasi) ─────────────────────────

model PanelInvoice {
  id            String    @id @default(cuid())
  number        String    @unique
  customerName  String
  customerEmail String?
  description   String
  amount        Float     @default(0)
  currency      String    @default("TRY")
  status        String    @default("UNPAID") // UNPAID | PAID | CANCELLED
  source        String    @default("MANUAL") // MANUAL | STORE
  sourceId      String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@map("panel_invoices")
}

model StoreOrder {
  id                  String   @id @default(cuid())
  packageId           String
  packageName         String
  price               Float    @default(0)
  contactEmail        String
  desiredUsername     String?
  note                String?
  status              String   @default("PENDING") // PENDING | PAID | FULFILLED | CANCELLED
  provisionedUserId   String?
  provisionedUsername String?
  provisionedPassword String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@map("store_orders")
}

// ─── Connection ──────────────────────────────────────────────────────────────

model Connection {
  id        String    @id @default(cuid())
  ip        String
  userAgent String?
  token     String?
  startedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?
  bytesIn   BigInt    @default(0)
  bytesOut  BigInt    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  serverId String?
  server   Server? @relation(fields: [serverId], references: [id])

  @@index([userId, endedAt])
  @@index([streamId, endedAt])
  @@index([startedAt])
  @@index([updatedAt])
  @@map("connections")
}

// ─── Migration ───────────────────────────────────────────────────────────────

model MigrationJob {
  id               String          @id @default(cuid())
  source           MigrationSource
  status           MigrationStatus @default(PENDING)
  totalRecords     Int             @default(0)
  processedRecords Int             @default(0)
  failedRecords    Int             @default(0)
  errors           Json?
  filePath         String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("migration_jobs")
}

// ─── Settings (singleton) ────────────────────────────────────────────────────

model AdminGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isAdmin     Boolean  @default(false) // tam yetki (tum izinleri bypass eder)
  isReseller  Boolean  @default(false) // bayi paneli yetkileri
  isBanned    Boolean  @default(false) // gruptaki tum hesaplar engelli
  permissions String[] @default([])    // izin anahtarlari (permissions.catalog)
  isSystem    Boolean  @default(false) // silinemez cekirdek grup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("admin_groups")
}

model Settings {
  id                      String   @id @default("singleton")
  vodDownloadSpeed        Int      @default(200)
  vodDownloadLimit        Int      @default(20)
  bufferSize              Int      @default(8192)
  blockVpnProxy           Boolean  @default(false)
  priorityBackupStream    Boolean  @default(false)
  streamDownVideo         String?
  bannedVideo             String?
  expiredVideo            String?
  countryLockVideo        String?
  maxConxExceedVideo      String?
  enableConxExceedLog     Boolean  @default(false)
  instantCloseConn        Boolean  @default(false)
  adminStreamingIps       String[] @default([])
  panelName               String   @default("XtreamPulsar")
  currency                String   @default("TRY") // panel geneli varsayilan para birimi (kod)
  commissionRate          Int      @default(0) // affiliate komisyon yuzdesi (0 = kapali)
  // Otomatik ban: kisa surede cok kez engellenen IP'leri otomatik banla
  autoBanEnabled          Boolean  @default(false)
  autoBanThreshold        Int      @default(10)
  autoBanWindowMins       Int      @default(60)
  autoBanDurationMins     Int      @default(1440)
  // Sistem kaynak izleme (CPU/RAM/disk esik uyarilari)
  sysMonitorEnabled       Boolean  @default(false)
  cpuAlertPct             Int      @default(90)
  memAlertPct             Int      @default(90)
  diskAlertPct            Int      @default(90)
  netAlertMbps            Int      @default(0) // toplam ag throughput uyari esigi (Mbps, 0 = kapali)
  // On-demand uyutma — izleyicisi olmayan TRANSCODE yayinini durdur, istek gelince otomatik uyandir (uykuda: default kapali)
  idleSleepEnabled        Boolean  @default(false)
  idleSleepMins           Int      @default(10) // kac dk 0 izleyiciden sonra uyut
  // Indirme yoneticisi
  downloadSpeedKbps       Int      @default(0)  // indirme-basi max hiz KB/s (0=sinirsiz)
  downloadConcurrency     Int      @default(3)  // ayni anda max indirme
  watchFolderEnabled      Boolean  @default(false)
  watchFolderPath         String?
  watchFolderBouquetId    String?
  watchFolderIntervalMins Int      @default(5)
  downloadAutoVod         Boolean  @default(false) // tamamlaninca otomatik VOD ekle (varsayilan)
  // Anti-piracy / real-IP
  realIpMode              String   @default("auto") // auto | cf | xff-first | xff-last (Cloudflare/proxy arkasi gercek client IP)
  // Restreamer/scraper tespiti (bir pencerede anormal sayida farkli kanal = ripper)
  restreamDetectEnabled   Boolean  @default(false)
  restreamWindowMins      Int      @default(60)
  restreamDistinctThreshold Int    @default(40) // pencerede kac farkli kanal supheli
  restreamAutoBan         Boolean  @default(false) // esigi asani otomatik banla (varsayilan: sadece listele)
  // Altyazi arama/indirme (OpenSubtitles) — anahtar girilene kadar uykuda
  subtitleEnabled         Boolean  @default(false)
  subtitleApiKey          String   @default("")
  subtitleUsername        String   @default("")
  subtitlePassword        String   @default("")
  serverUrl               String   @default("")
  serverUrls              String[] @default([])
  primaryUrlIndex         Int      @default(0)
  urlHealthCheck          Boolean  @default(true)
  serverPort              Int      @default(25461)
  timezone                String   @default("UTC")
  trialUserLimit          Int      @default(500)
  trialDays               Int      @default(7)
  trialMaxConnections     Int      @default(1)
  adminEmail              String   @default("")
  resellerNotifyExpiry    Boolean  @default(true)
  streamDownAlert         Boolean  @default(true)
  enableLocalBackups      Boolean  @default(false)
  localBackupDir          String   @default("/opt/xtreampulsar/backups")
  autoBackupIntervalHours Int      @default(6)
  backupsToKeep           Int      @default(5)
  enableRemoteBackup      Boolean  @default(false)
  dropboxApiKey           String   @default("")
  backupEncryptionKey     String?
  discordWebhookUrl       String?
  telegramBotToken        String?
  telegramChatId          String?
  discordAlerts           Boolean  @default(false)
  telegramAlerts          Boolean  @default(false)
  tmdbApiKey              String?
  autoEnrichMetadata      Boolean  @default(false)
  // Reseller
  registrationOpen        Boolean  @default(false)
  tierPricing             Json     @default("{}")
  creditPricing           Json?
  // AI destek botu (uykuda — anahtar girilene kadar)
  aiEnabled               Boolean  @default(false)
  aiProvider              String   @default("anthropic")
  aiApiKey                String   @default("")
  aiModel                 String   @default("")
  aiSystemPrompt          String?
  // White-label panel adresleri (hostname gating)
  resellerPanelHost       String?
  clientPanelHost         String?
  // Panel geo-block
  geoBlockEnabled         Boolean  @default(false)
  allowedCountries        String[] @default([])
  // Security / Server Guard
  enableGuard             Boolean  @default(false)
  maxConnsPerIp           Int      @default(10)
  maxHitsNormal           Int      @default(100)
  maxHitsRestreamer       Int      @default(50)
  blockDuration           Int      @default(60)
  denyInvalidStreamIds    Boolean  @default(true)
  sensitivePorts          String[] @default([])
  whitelistIPs            String[] @default([])
  openPorts               String[] @default([])
  // ─── Roadmap C: Yayin guvenligi ───────────────────────────────────────────
  disallowEmptyUa         Boolean  @default(false) // User-Agent'i bos istekleri reddet (canli yayin)
  autoKickAfterHours      Int      @default(0)      // N saatten uzun acik hatti otomatik dusur (0=kapali)
  floodLimitPerMin        Int      @default(0)      // IP basi dakikada max yeni yayin istegi (0=kapali)
  restreamerPrebufferKb   Int      @default(0)      // restreamer prebuffer ipucu (KB)
  splitByLoad             Boolean  @default(false)  // yuke gore LB dagitim ipucu
  randomRtmpIp            Boolean  @default(false)  // RTMP cikisini rastgele IP'ye bagla
  ffmpegProbeSize         Int      @default(0)      // varsayilan ffmpeg -probesize (0=oto)
  ffmpegAnalyzeDurationUs Int      @default(0)      // varsayilan ffmpeg -analyzeduration us (0=oto)
  // ─── Roadmap C: Uygulama guvenligi ────────────────────────────────────────
  minPasswordLength       Int      @default(6)      // min sifre uzunlugu (kullanici/bayi)
  maxLoginAttempts        Int      @default(5)      // ardil basarisiz giris esigi
  loginLockoutMins        Int      @default(15)     // esik asilinca kilit suresi (dk)
  logoutOnIpChange        Boolean  @default(false)  // oturum IP degisince cikis (ileride devreye)
  recaptchaEnabled        Boolean  @default(false)  // giris/kayit formunda reCAPTCHA
  recaptchaSiteKey        String   @default("")
  recaptchaSecretKey      String   @default("")
  // ─── Roadmap C: Bayi izinleri ─────────────────────────────────────────────
  resellerAllowChangeDns      Boolean @default(true)   // bayi DNS/sunucu URL degistirebilir
  resellerAllowChangeUsername Boolean @default(false)  // bayi kullanici adi degistirebilir
  resellerAllowChangeEmail    Boolean @default(true)   // bayi e-posta degistirebilir
  updatedAt               DateTime @updatedAt

  @@map("settings")
}

// ─── UserBouquet ─────────────────────────────────────────────────────────────

model UserBouquet {
  userId    String
  bouquetId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bouquet   Bouquet @relation(fields: [bouquetId], references: [id], onDelete: Cascade)

  @@id([userId, bouquetId])
  @@map("user_bouquets")
}

// ─── BackupLog ───────────────────────────────────────────────────────────────

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  type      String   @default("LOCAL")
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())

  @@map("backup_logs")
}

// ─── NotificationLog ─────────────────────────────────────────────────────────

// ─── BlockedAttempt (engellenen baglanti denemeleri — anti-abuse gorunurlugu) ─

model BlockedAttempt {
  id        String   @id @default(cuid())
  userId    String?
  username  String?
  ip        String?
  country   String?
  reason    String
  category  String   // MAX_CONN | IP_CAP | IP_NOT_ALLOWED | COUNTRY_BLOCKED | VPN_BLOCKED | DEVICE_LOCKED
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@map("blocked_attempts")
}

model NotificationLog {
  id            String   @id @default(cuid())
  type          String
  recipient     String
  subject       String   // ham metin (e-posta + eski kayitlar icin yedek)
  messageKey    String?  // i18n anahtari — panelde izleyenin diline gore cevrilir
  messageParams Json?    // i18n interpolasyon parametreleri ( or. {username, days})
  status        String   @default("SENT")
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("notification_logs")
}

// ─── StreamHealthLog ─────────────────────────────────────────────────────────

model StreamHealthLog {
  id           String   @id @default(cuid())
  streamId     String
  stream       Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  status       String
  responseTime Int?
  errorMessage String?
  checkedAt    DateTime @default(now())

  @@index([streamId, checkedAt])
  @@map("stream_health_logs")
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  actorId    String?
  actorType  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId, actorType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── MagDevice (Stalker/MAG) ─────────────────────────────────────────────────

model MagDevice {
  id           String    @id @default(cuid())
  mac          String    @unique
  serialNumber String?
  token        String?
  lastSeen     DateTime  @default(now())
  createdAt    DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([mac])
  @@map("mag_devices")
}

// ─── ApiKey ──────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  permissions String[]  @default(["read"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

// ─── WhiteLabel ───────────────────────────────────────────────────────────────

model WhiteLabel {
  id             String   @id @default(cuid())
  panelName      String
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#8b5cf6")
  customDomain   String?  @unique
  customCss      String?
  footerText     String?
  supportEmail   String?
  supportUrl     String?
  isActive       Boolean  @default(true)
  licenseKey     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("white_labels")
}

// ─── BandwidthLog ─────────────────────────────────────────────────────────────

model BandwidthLog {
  id       String   @id @default(cuid())
  streamId String?
  serverId String?
  bytesIn  BigInt   @default(0)
  bytesOut BigInt   @default(0)
  hour     DateTime

  @@unique([streamId, serverId, hour])
  @@index([hour])
  @@map("bandwidth_logs")
}

// ─── UserActivityLog ─────────────────────────────────────────────────────────

model UserActivityLog {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           String
  streamId         String?
  ip               String?
  userAgent        String?
  duration         Int?
  bytesTransferred BigInt?
  country          String?
  deviceType       String?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_activity_logs")
}

model Webhook {
  id            String    @id @default(cuid())
  name          String
  url           String
  secret        String?
  events        String[]
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  lastStatus    Int?
  createdAt     DateTime  @default(now())

  @@map("webhooks")
}

// ─── Control Panel ────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  company   String?
  country   String?
  notes     String?
  status    String    @default("ACTIVE")
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  licenses CustomerLicense[]
  tickets  Ticket[]
  invoices Invoice[]

  @@map("customers")
}

model CustomerLicense {
  id             String    @id @default(cuid())
  key            String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  plan           String    @default("STARTER")
  status         String    @default("TRIAL")
  serverIp       String?
  serverDomain   String?
  version        String?
  maxUsers       Int       @default(500)
  maxServers     Int       @default(2)
  trialEndsAt    DateTime?
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  lastSeenAt     DateTime?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs    CustomerLicenseLog[]
  tickets Ticket[]

  @@map("customer_licenses")
}

model CustomerLicenseLog {
  id        String          @id @default(cuid())
  licenseId String
  license   CustomerLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  serverIp  String
  success   Boolean
  message   String?
  createdAt DateTime        @default(now())

  @@map("customer_license_logs")
}

model Ticket {
  id           String           @id @default(cuid())
  ticketNo     String           @unique
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  licenseId    String?
  license      CustomerLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  subject      String
  status       String           @default("OPEN")
  priority     String           @default("MEDIUM")
  category     String           @default("GENERAL")
  panelUrl     String?
  panelVersion String?
  serverIp     String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content    String
  isStaff    Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())

  @@map("ticket_messages")
}

model Invoice {
  id         String    @id @default(cuid())
  invoiceNo  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  amount     Float
  currency   String    @default("EUR")
  status     String    @default("PENDING")
  plan       String?
  period     String?
  stripeId   String?
  paidAt     DateTime?
  dueAt      DateTime?
  createdAt  DateTime  @default(now())

  @@map("invoices")
}

model ControlAdmin {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("control_admins")
}


enum ClientRequestType {
  REPORT
  NEW_CHANNEL
}

enum ClientRequestStatus {
  OPEN
  RESOLVED
  REJECTED
}

model ClientRequest {
  id         String              @id @default(cuid())
  type       ClientRequestType
  status     ClientRequestStatus @default(OPEN)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamId   String?
  stream     Stream?             @relation(fields: [streamId], references: [id], onDelete: SetNull)
  title      String
  message    String?
  adminNote  String?
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
  messages   ClientRequestMessage[]

  @@index([status])
  @@index([type])
  @@map("client_requests")
}

model ClientRequestMessage {
  id        String        @id @default(cuid())
  requestId String
  request   ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender    String        // USER | ADMIN
  body      String
  createdAt DateTime      @default(now())

  @@index([requestId])
  @@map("client_request_messages")
}


model M3uSource {
  id               String    @id @default(cuid())
  name             String
  url              String
  defaultType      String    @default("LIVE")
  defaultBouquetId String?
  conflictMode     String    @default("MERGE")
  enabled          Boolean   @default(true)
  intervalMinutes  Int       @default(360)
  lastSyncedAt     DateTime?
  lastStatus       String?
  lastMessage      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("m3u_sources")
}


model ResellerApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  resellerId String
  reseller   Reseller  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([key])
  @@index([resellerId])
  @@map("reseller_api_keys")
}


model ActivationCode {
  id             String    @id @default(cuid())
  code           String    @unique
  durationDays   Int
  maxConnections Int?
  status         String    @default("ACTIVE") // ACTIVE | DISABLED
  note           String?
  packageId      String?
  userId         String?   // bagli abone hatti (username = password = code)
  usedByUserId   String?   // legacy, kullanilmiyor
  usedByUsername String?   // legacy, kullanilmiyor
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@map("activation_codes")
}


model DownloadJob {
  id              String   @id @default(cuid())
  url             String
  filename        String   // hedef dosya adi (sanitize edilmis)
  status          String   @default("QUEUED") // QUEUED | DOWNLOADING | PAUSED | COMPLETED | FAILED | CANCELED
  totalBytes      BigInt   @default(0)
  downloadedBytes BigInt   @default(0)
  speedBps        Int      @default(0) // anlik hiz (byte/sn)
  connections     Int      @default(16) // aria2 baglanti sayisi
  autoVod         Boolean  @default(false) // tamamlaninca otomatik VOD ekle
  priority        Int      @default(0)     // kuyruk onceligi (buyuk = once)
  error           String?
  categoryId      String?  // VOD olarak eklenince kullanilacak kategori
  createdStreamId String?  // olusturulan VOD stream id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("download_jobs")
}

model WatchImport {
  id            String   @id @default(cuid())
  path          String   @unique
  kind          String   // MOVIE | EPISODE
  title         String
  season        Int?
  episode       Int?
  streamId      String?
  episodeId     String?
  status        String   @default("OK") // OK | SKIPPED | ERROR
  message       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("watch_imports")
}

model Widget {
  id                String   @id @default(cuid())
  publicKey         String   @unique
  name              String
  type              String   @default("STORE") // TRIAL | STORE | RENEWAL
  enabled           Boolean  @default(true)
  title             String?
  subtitle          String?
  accentColor       String   @default("#6d28d9")
  trialPackageId    String?
  trialDurationDays Int      @default(1)
  allowedPackageIds String[] @default([])
  successMessage    String?
  redirectUrl       String?
  perIpDailyLimit   Int      @default(5)
  oneTrialPerDevice Boolean  @default(true)  // ayni cihaz/IP tek deneme alabilir
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leads WidgetLead[]

  @@map("widgets")
}

model WidgetLead {
  id        String   @id @default(cuid())
  widgetId  String
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  type      String
  ip        String?
  email     String?
  username  String?
  result    String   @default("OK") // OK | LIMITED | ERROR
  message   String?
  deviceId  String?
  createdAt DateTime @default(now())

  @@index([widgetId, createdAt])
  @@index([ip, createdAt])
  @@index([widgetId, deviceId])
  @@map("widget_leads")
}

model StreamProvider {
  id             String    @id @default(cuid())
  name           String
  type           String    @default("XTREAM") // XTREAM | M3U
  host           String
  username       String?
  password       String?
  userAgent      String?
  isActive       Boolean   @default(true)
  status         String    @default("UNKNOWN") // ONLINE | OFFLINE | UNKNOWN
  lastCheckedAt  DateTime?
  lastError      String?
  maxConnections Int?
  expiresAt      DateTime?

  // Mirror config (Increment 2)
  mirrorBouquetId String?
  mirrorServerId  String?
  outputExt       String   @default("ts")  // ts | m3u8 (LIVE cikti uzantisi)
  dropPolicy      String   @default("KEEP") // KEEP | DISABLE | DELETE (upstream'den kaybolan yayinlar)
  importLive      Boolean  @default(true)
  importVod       Boolean  @default(false)
  importSeries    Boolean  @default(false)
  lastSyncedAt    DateTime?
  lastSyncAdded   Int?
  lastSyncUpdated Int?
  lastSyncRemoved Int?
  lastSyncTotal   Int?

  // Auto-sync + filtreleme (Increment 3)
  autoSync            Boolean  @default(false)
  syncIntervalMinutes Int      @default(720)   // otomatik yenileme aralıği (dk)
  skipKeywords        String[] @default([])    // ad/kategori bu kelimeleri iceriyorsa atla
  lastSyncStatus      String?                  // OK | ERROR | RUNNING
  lastSyncMessage     String?

  streams Stream[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("stream_providers")
}
