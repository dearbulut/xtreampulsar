NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xtreampulsar"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=change-me-in-production-min-16-chars
JWT_EXPIRES_IN=7d

# License service
LICENSE_SERVER_URL=http://localhost:3001

# Xtream server identity (returned in server_info to clients)
SERVER_URL=http://localhost
SERVER_PORT=8080
